#!/usr/bin/env bash

trap 'exit 1' INT TERM

if [[ -e $HOME/.config/containers/storage.conf ]]; then
  export CONTAINERS_STORAGE_CONF=$HOME/.config/containers/storage.conf
fi

# Check prerequisites
! command -v podman &>/dev/null && { echo "Error: podman required for this program" ; exit 1 ; }
! command -v krun   &>/dev/null && { echo "Error: krun required for this program" ; exit 1 ; }
! command -v crun   &>/dev/null && { echo "Error: crun required for this program" ; exit 1 ; }
if [[ "$(crun --version)" != *LIBKRUN* ]]; then
  echo "Error: crun not compiled with krun support" >&2
  exit 1
fi

update_containerfile() {
  if [[ -e "$HOME"/.config/"$progname"/Containerfile ]]; then
    cp "$HOME"/.config/"$progname"/Containerfile "$HOME"/.config/"$progname"/Containerfile."$(date +"%Y%m%d-%H%M%S")"
  fi
  cat <<EOF > "$HOME"/.config/"$progname"/Containerfile
    FROM docker.io/library/node:26-trixie-slim
    ENV DEBIAN_FRONTEND=noninteractive

    RUN \
        . /etc/os-release \
        && apt-get update && apt-get install -y --no-install-recommends \
            git ripgrep vim curl ca-certificates jq less procps openssh-client \
            podman fuse-overlayfs uidmap slirp4netns locales tmux iproute2 \
            dbus-bin python3 python3-venv python3-pip build-essential pkg-config \
            unzip zip xz-utils bzip2 shellcheck ncurses-term rsync file tree \
        && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
        && locale-gen \
        && rm -rf /var/lib/apt/lists/*

    RUN npm install -g \
          npm@12 \
          @anthropic-ai/claude-code \
          opencode-ai \
          @rynfar/meridian \
          opencode-with-claude && \
        npm install -g --ignore-scripts @earendil-works/pi-coding-agent

    RUN dbus-uuidgen --ensure=/etc/machine-id

    USER node
    ENV HOME=/home/node
    WORKDIR /workspace
EOF
  sed -Ei 's/^ {4}//' "$HOME"/.config/"$progname"/Containerfile
}

# Container build function to be called with -b or if the container does not exist
build_container() {
  builddir=$(mktemp -d) || return 1
  trap 'rm -Rf -- "$builddir"' EXIT

  if [[ ! -r "$HOME"/.config/"$progname"/Containerfile ]]; then
    update_containerfile
  fi

  # Copy config Containerfile to builddir
  cp "$HOME"/.config/"$progname"/Containerfile "$builddir"/
  podman build -t "$progname" "$builddir"
  podman image prune -f > /dev/null

  # Clean up builddir
  rm -Rf -- "$builddir"
  trap - EXIT
}

progname="agent-sandbox"
sandbox_name=$progname
sandbox_home=
agents=(claude opencode pi bash)
default_agent=claude
use_tmux=true
# shellcheck disable=1090
[[ -r "$HOME"/.config/"$progname"/config ]] && source "$HOME"/.config/"$progname"/config

if [[ " ${agents[*]} " != *" $default_agent "* ]]; then
  echo "Warning: default_agent must be one of ${agents[*]} - using claude" >&2
  default_agent=claude
fi

if [[ "$use_tmux" != true && "$use_tmux" != false ]]; then
  echo "Warning: use_tmux must be true or false - using true" >&2
  use_tmux=true
fi

usage() {
  echo "usage: ${0##*/} [Options] [workspace] [-- agent_options]"
  echo
  echo "Options:"
  echo "  -h      : this help text"
  echo "  -n NAME : Name for the sandbox (default: $sandbox_name)"
  echo "  -H HOME : Use a separate HOME directory for sandbox (default: ~/.local/share/$progname/homes/NAME)"
  echo "  -b      : (re-)build the container"
  echo "  -c      : run with claude"
  echo "  -o      : run with opencode"
  echo "  -p      : run with pi"
  echo "  -s      : run bash shell in sandbox"
  echo "  -r      : run bash shell as root in sandbox"
  echo "  -t      : run inside tmux"
  echo "  -T      : do not run inside tmux"
  echo "  -C      : update ~/.config/$progname/Containerfile from template"
  echo "Default Agent: $default_agent"
  echo "Use tmux: $use_tmux"
  exit "${1:-0}"
}

agent=$default_agent
build_only=false
podman_args=()
# shellcheck disable=2034
while getopts ":hn:H:bcopsrtTC" opt; do
  case $opt in
    n) sandbox_name=$OPTARG ;;
    H) sandbox_home=$OPTARG ;;
    b) build_only=true ;;
    c) agent=claude ;;
    o) agent=opencode ;;
    p) agent=pi ;;
    s) agent=bash ;;
    r) agent=bash ; podman_args+=(-u root) ;;
    t) use_tmux=true ;;
    T) use_tmux=false ;;
    C) echo "Updating ~/.config/$progname/Containerfile from template"
       update_containerfile
       exit ;;
    h) usage ;;
    :) echo "-$OPTARG requires an argument" ; exit 1 ;;
    \?) echo "Unknown option: -$OPTARG" ; exit 1 ;;
  esac
done
# getopts consumes a leading "--"; if it did, everything left is agent options
dashdash=0
(( OPTIND > 1 )) && [[ "${*:OPTIND-1:1}" == -- ]] && dashdash=1
shift $(( OPTIND - 1 ))
: "${sandbox_name:=$HOME/.local/share/$progname/homes/$sandbox_name}"

# The sandbox name is used as a path component
if [[ ! "$sandbox_name" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
  echo "Error: Invalid sandbox name '$sandbox_name' (use letters, digits, '.', '_' and '-')" >&2
  exit 1
fi

# Build the container and exit with -b
if $build_only; then
  build_container
  exit
fi

# Set up workspace directory (create if necessary)
workspace=$PWD
if (( ! dashdash && $# > 0 )); then
  if [[ ! -d "$1" ]]; then
    echo "Creating workspace $1" >&2
    if ! mkdir -p "$1"; then
      exit 1
    fi
    if [[ ! -d "$1" ]]; then
      echo "Error: Could not create workspace $1" >&2
      exit 1
    fi
  fi
  workspace=$(realpath -- "$1") || exit 1
  shift
  [[ "$1" == -- ]] && shift
fi

if [[ "$workspace" == "$(realpath -- "$HOME")" ]]; then
  read -rp "Warning: The workspace is $HOME; if this is intentional, enter 'yes' in all caps: "
  [[ "$REPLY" != "YES" ]] && exit 1
fi

# Verify $agent is in supported agents list
if [[ " ${agents[*]} " != *" $agent "* ]]; then
  echo "Error: Agent must be one of ${agents[*]}" >&2
  exit 1
fi

# Verify podman networks exist
if ! podman network exists "$progname"-internal; then
  podman network create --internal --subnet 192.0.2.0/24 "$progname"-internal | grep -v "$progname"-internal
fi
if ! podman network exists "$progname"-egress; then
  podman network create "$progname"-egress | grep -v "$progname"-egress
fi

# Setup squid container if necessary
if [[ "$(podman container inspect -f '{{.State.Running}}' "$progname"-squid 2>/dev/null)" != true ]]; then
  [[ ! -d "$HOME"/.config/"$progname" ]] && mkdir -p "$HOME"/.config/"$progname"

  if [[ ! -e "$HOME"/.config/"$progname"/squid.conf ]]; then
    # squid.conf contents
    cat <<EOF > "$HOME"/.config/"$progname"/squid.conf
    # Add additional acls here (domains + subdomains must have leading dot)
    # acl agent_https_allowed dstdomain SITE
    # acl agent_https_allowed dstdomain .DOMAIN

    acl agent_https_allowed dstdomain api.anthropic.com
    acl agent_https_allowed dstdomain bridge.claudeusercontent.com
    acl agent_https_allowed dstdomain claude.com
    acl agent_https_allowed dstdomain code.claude.com
    acl agent_https_allowed dstdomain downloads.claude.ai
    acl agent_https_allowed dstdomain mcp-proxy.anthropic.com
    acl agent_https_allowed dstdomain platform.claude.com

    acl agent_https_allowed dstdomain models.dev
    acl agent_https_allowed dstdomain .opencode.ai
    acl agent_https_allowed dstdomain pi.dev

    acl agent_https_allowed dstdomain registry.npmjs.org
    acl agent_https_allowed dstdomain archive.ubuntu.com
    acl agent_https_allowed dstdomain download.docker.com
    # acl agent_https_allowed dstdomain api.github.com
    # acl agent_https_allowed dstdomain github.com

    acl agent_src src 192.0.2.0/24
    acl SSL_ports port 443
    acl CONNECT method CONNECT

    http_access deny !agent_src
    http_access deny CONNECT !SSL_ports
    http_access allow CONNECT agent_https_allowed
    http_access deny all

    http_port 3128
    cache deny all
    via off
    forwarded_for delete
EOF
    sed -Ei 's/^ {4}//' "$HOME"/.config/"$progname"/squid.conf
    echo "Be sure to customize $HOME/.config/$progname/squid.conf"
    echo "Then restart squid with: podman restart $progname-squid"
  fi

  # Create systemd service for squid
  [[ ! -d ~/.config/containers/systemd ]] && mkdir -p ~/.config/containers/systemd

  # Create network definition for internal network
  if [[ ! -e "$HOME"/.config/containers/systemd/"$progname"-internal.network ]]; then
    {
      printf '[Network]\n'
      printf 'NetworkName=%s-internal\n' "$progname"
      printf 'Subnet=192.0.2.0/24\n'
      printf 'Internal=true\n'
    } > "$HOME"/.config/containers/systemd/"$progname"-internal.network
  fi

  # Create network definition for egress network
  if [[ ! -e "$HOME"/.config/containers/systemd/"$progname"-egress.network ]]; then
    {
      printf '[Network]\n'
      printf 'NetworkName=%s-egress\n' "$progname"
    } > "$HOME"/.config/containers/systemd/"$progname"-egress.network
  fi

  # Create quadlet service definition for squid container
  if [[ ! -e "$HOME"/.config/containers/systemd/"$progname"-squid.container ]]; then
    {
      printf '[Unit]\n'
      printf 'Description=Squid egress proxy for %s sandboxes\n' "$progname"
      printf 'After=%s-internal-network.service %s-egress-network.service\n' "$progname" "$progname"
      printf 'Requires=%s-internal-network.service %s-egress-network.service\n' "$progname" "$progname"
      printf '\n'
      printf '[Container]\n'
      printf 'ContainerName=%s-squid\n' "$progname"
      printf 'Image=docker.io/ubuntu/squid:latest\n'
      printf 'Network=%s-internal.network:ip=192.0.2.2\n' "$progname"
      printf 'Network=%s-egress.network\n' "$progname"
      printf 'Volume=%%h/.config/%s/squid.conf:/etc/squid/squid.conf:ro\n' "$progname"
      printf 'NoNewPrivileges=true\n'
      printf 'DropCapability=ALL\n'
      printf 'AddCapability=SETUID SETGID CHOWN DAC_OVERRIDE\n'
      printf '\n'
      printf '[Service]\n'
      printf 'Restart=always\n'
      printf 'TimeoutStartSec=300\n'
      printf '\n'
      printf '[Install]\n'
      printf 'WantedBy=default.target\n'
    } > "$HOME"/.config/containers/systemd/"$progname"-squid.container
  fi

  # Create systemd unit files for the podman objects
  if [[ ! -e "$HOME"/.config/systemd/user/"$progname"-egress-network.service ||
        ! -e "$HOME"/.config/systemd/user/"$progname"-internal-network.service ||
        ! -e "$HOME"/.config/systemd/user/"$progname"-squid.service ]]; then
    /usr/lib/systemd/system-generators/podman-system-generator --user "$HOME"/.config/systemd/user
    systemctl --user daemon-reload
  fi

  # Allow the process to start and run when user it not logged in
  loginctl enable-linger "$USER"

  # Start squid
  systemctl --user enable --now "$progname"-squid.service
fi

# Create podman image, if necessary
if ! podman image exists localhost/$progname:latest; then
  build_container
  if ! podman image exists localhost/$progname:latest; then
    echo "Error: Could not build $progname podman image" >&2
    exit 1
  fi
fi

# Create directory for sandbox user data
if [[ "$(realpath -- "$sandbox_home")" == "$(realpath -- "$HOME")" ]]; then
  read -rp "Warning: The sandbox home is $HOME; if this is intentional, enter 'yes' in all caps: "
  [[ "$REPLY" != "YES" ]] && exit 1
fi

mkdir -p "$sandbox_home" || exit 1
sandbox_home=$(realpath -- "$sandbox_home") || exit 1

# Set up .bashrc: start from the image's skeleton, then add meridian startup
if [[ ! -e "$sandbox_home"/.bashrc ]]; then
  podman run --rm "$progname" cat /etc/skel/.bashrc > "$sandbox_home"/.bashrc 2>/dev/null
  sed -E 's/^ {2}//' >> "$sandbox_home"/.bashrc <<'EOF'

  if [[ "$SANDBOX_AGENT" == opencode || "$SANDBOX_AGENT" == bash ]]; then
    export ANTHROPIC_API_KEY=x
    export ANTHROPIC_BASE_URL=http://127.0.0.1:3456
    if ! pgrep -f "node (/usr(/local)?/bin/)?[m]eridian" &>/dev/null; then
      mkdir -p ~/.cache
      setsid -f meridian &>~/.cache/meridian.log
      # Wait for meridian to accept connections
      for _ in {1..50}; do
        (exec 3<>/dev/tcp/127.0.0.1/3456) 2>/dev/null && break
        sleep 0.1
      done
    fi
  fi
EOF
fi

# Set up tmux config
if [[ ! -e "$sandbox_home"/.tmux.conf ]]; then
  sed -E 's/^ {2}//' > "$sandbox_home"/.tmux.conf <<'EOF'
  # Short escape time keeps Esc responsive in vim and opencode
  set -s escape-time 10
  set -g mouse on
  set -g history-limit 50000
  # Keep the window open if the agent fails so the error can be read
  set -g remain-on-exit failed
  # Use C-a so it does not clash with a tmux running on the host
  unbind C-b
  set -g prefix C-a
  bind C-a send-prefix
EOF
fi

cmd=(bash -ic 'exec "$@"' bash "$agent" "$@")
if [[ "$use_tmux" == true ]]; then
  cmd=(tmux new-session -s "$agent" -n "$agent" -- "${cmd[@]}")
fi

sandbox_name_base=$sandbox_name
if podman container exists "$sandbox_name" &>/dev/null; then
  sandbox_name=$sandbox_name_base-$$
fi
while podman container exists "$sandbox_name" &>/dev/null; do
  sandbox_name=$sandbox_name_base-$RANDOM
done

exec podman run -it --rm \
  --name "$sandbox_name" \
  --hostname "$sandbox_name" \
  --runtime krun \
  --network "$progname"-internal \
  --userns keep-id:uid="$(id -u)",gid="$(id -g)" \
  --security-opt no-new-privileges \
  -v "$workspace":/workspace \
  -v "$sandbox_home":/home/node \
  -w /workspace \
  -e "SANDBOX_AGENT=$agent" \
  -e TERM=xterm-256color \
  -e LANG=en_US.UTF-8 \
  -e HOME=/home/node \
  -e http_proxy=http://192.0.2.2:3128 \
  -e https_proxy=http://192.0.2.2:3128 \
  -e no_proxy=localhost,127.0.0.1 \
  -e NODE_USE_ENV_PROXY=1 \
  "${podman_args[@]}" \
  "$progname" "${cmd[@]}"

